{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["apps/mobile/**"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "passThroughEnv": ["SUPABASE_SERVICE_ROLE_KEY"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
