{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "apps/mobile/app/**",
    "apps/mobile/components/**",
    "apps/mobile/lib/**",
    "apps/mobile/public/**",
    "apps/mobile/app.json",
    "apps/mobile/app.config.js",
    "apps/mobile/package.json"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "passThroughEnv": ["SUPABASE_SERVICE_ROLE_KEY"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
